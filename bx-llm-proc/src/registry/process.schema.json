{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Process Registry",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string"
      },
      "pre": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "post": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        }
      },
      "meta": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputKind": {
            "enum": [
              "doc",
              "excel",
              "email",
              "plain"
            ]
          },
          "outputKind": {
            "enum": [
              "categories",
              "html",
              "string",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}