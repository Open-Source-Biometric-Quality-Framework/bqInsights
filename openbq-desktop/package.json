{
  "name": "openbq-desktop",
  "appname": "openbq desktop (Beta)",
  "icon": "doc",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "Open Biometric Quality Assessment",
  "author": "Ted Dunstone",
  "company": "Biometix",
  "main": "electron-dist/main.js",
  "splashfile": "public/splash.html",
  "logofile": "logo.png",
  "iconfile": "public/icon.png",
  "licence": {
    "name": "Commerical",
    "link": "www.biometix.com"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && copyfiles -u 1 electron/preload.cjs electron-dist/",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && npm run build:electron && electron --no-sandbox .\"",
    "electron:build": "npm run build:ui && npm run build:electron",
    "dist:osx": "source vars.sh && npm run electron:build && electron-builder",
    "dist:check": "rm -f ./release/*.dmg && npm run dist:unsigned && ./scripts/run-dmg.sh",
    "dist:mas": "source vars.sh && npm run electron:build && electron-builder --mac mas",
    "dist:unsigned": "npm run electron:build && electron-builder --mac --config.mac.identity=null",
    "dist:linux": "npm run electron:build && electron-builder --linux deb --config.npmRebuild=false",
    "dist:win": "npm run electron:build && electron-builder --win"
  },
  "dependencies": {
    "@biometix/bx-llm-engine": "*",
    "@biometix/bx-report": "^1.0.0",
    "@biometix/electron-main-common": "*",
    "@biometix/openbq": "^0.1.0",
    "@embedding-atlas/workspace": "github:apple/embedding-atlas",
    "@llm-tools/embedjs": "^0.1.31",
    "@llm-tools/embedjs-hnswlib": "^0.1.31",
    "@llm-tools/embedjs-loader-web": "^0.1.31",
    "@llm-tools/embedjs-ollama": "^0.1.31",
    "@llm-tools/embedjs-openai": "^0.1.31",
    "@tailwindcss/vite": "^4.1.18",
    "@turf/clusters-dbscan": "^7.3.1",
    "@turf/turf": "^7.3.1",
    "allotment": "^1.20.5",
    "als-statistics": "^2.1.0",
    "density-clustering": "^1.3.0",
    "embedding-atlas": "^0.20.0",
    "exceljs": "^4.4.0",
    "googleapis": "^169.0.0",
    "llm-tools": "^0.2.5",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "marked": "^17.0.1",
    "ml-pca": "^4.1.1",
    "node-html-markdown": "^2.0.0",
    "open": "^11.0.0",
    "openai": "*",
    "papaparse": "^5.5.3",
    "plotly.js-dist-min": "^3.4.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.4",
    "sdbscan": "^0.3.3",
    "supercluster": "^8.0.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/density-clustering": "^1.3.3",
    "@types/node": "^24.10.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "electron": "45.3.4",
    "electron-builder": "^26.18.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "build": {
    "appId": "com.bixelab.openbq",
    "productName": "OpenBQ",
    "generateUpdatesFilesForAllChannels": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/mammoth/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "files": [
      "dist/**",
      "public/**",
      "electron-dist/**",
      "package.json",
      "node_modules/@biometix/**",
      "node_modules/openbq"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "OpenBQ-${version}-mac.${ext}",
      "icon": "public/icons.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "mas": {
      "type": "distribution",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/DraftIQ_MacAppStore.provisionprofile",
      "identity": "FC7E379A2C1BC6642E2EBC06C7C897F9F3F97E67",
      "target": [
        {
          "target": "mas",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nodeGypRebuild": false,
    "win": {
      "artifactName": "OpenBQ-${version}-win.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "Ted Dunstone <ted@bixelab.com>",
      "category": "utility",
      "artifactName": "OpenBQ-${version}-linux.${ext}",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
