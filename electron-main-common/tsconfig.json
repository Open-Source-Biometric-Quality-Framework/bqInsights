{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,

    "strict": false,
    "skipLibCheck": true,
  },
  "include": ["src"]
}
