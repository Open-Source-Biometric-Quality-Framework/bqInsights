{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "noImplicitAny": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
"useUnknownInCatchVariables": false,
"skipLibCheck": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src"]
}
